#!/usr/bin/env ruby
# Starts a live session on the IAC Driver bus with the clips and instruments
# in script/, then drops into IRB with `client` and `live` in scope.
require 'irb'
require 'bundler/setup'
require 'archaeopteryx'

entity = RCoreMidi::Device.all.detect { |device| device.name == 'IAC Driver' }.entities.first

Archaeopteryx::Application.config.bpm = 180
Dir[File.join(__dir__, 'clips', '*.rb')].each { |clip| load clip }
Dir[File.join(__dir__, 'instruments', '*.rb')].each { |instrument| load instrument }

client = Archaeopteryx::Client.new('Archaeopteryx console')
client.midi_in = entity.sources.first
client.midi_out = entity.destinations.first
client.create_live
live = client.live

Thread.new { client.start }
binding.irb
